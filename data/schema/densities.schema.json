{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/isaquefontinele/pitada/data/schema/densities.schema.json",
  "title": "Pitada ingredient densities",
  "description": "Grams per millilitre for common ingredients, each entry with at least one source.",
  "type": "object",
  "required": ["version", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "name", "gramsPerMl", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable identifier in English kebab-case.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "object",
          "required": ["pt", "en"],
          "additionalProperties": false,
          "properties": {
            "pt": { "type": "string", "minLength": 1 },
            "en": { "type": "string", "minLength": 1 }
          }
        },
        "gramsPerMl": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
        "notes": { "type": "string" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "detail": {
          "description": "The measure the value was derived from, e.g. \"1 cup (236.6 ml) = 125 g\".",
          "type": "string"
        }
      }
    }
  }
}
